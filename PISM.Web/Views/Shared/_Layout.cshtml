<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PISM</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PISM.Web.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Scan progress bar (hidden until a scan is active) -->
    <div id="scan-progress-bar" style="display:none; height:4px" class="bg-primary position-fixed top-0 start-0 end-0 z-3">
        <div id="scan-progress-inner" class="bg-success h-100" style="width:0;transition:width .3s"></div>
    </div>

    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">PISM</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Review" asp-action="Gallery">Review</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Scan" asp-action="Index">Scan</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Stats" asp-action="Index">Stats</a>
                        </li>
                    </ul>
                    <div id="nav-scan-status" class="text-white-50 small me-2" style="display:none">
                        <span class="spinner-border spinner-border-sm me-1"></span>
                        <span id="nav-scan-text">Scanning…</span>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-3">
        <main role="main" class="pb-3 pt-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/scan-progress.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
